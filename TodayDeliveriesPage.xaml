<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StitchBookApp.TodayDeliveriesPage"
             Title="TodayDeliveriesPage" BackgroundColor="#FFFFFF" NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="Auto,*">
        <Label  Grid.Row="0" TextColor="LightGray" 
    Margin="30,40,0,0"
Text="Today Deliveries"
FontSize="40"
FontAttributes="Bold"
VerticalOptions="StartAndExpand"
HorizontalOptions="StartAndExpand"/>
        <CollectionView  Grid.Row="1" x:Name="DeliveryList" Margin="30,0,30,0">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame BorderColor="#2F9E9E" CornerRadius="10" Margin="0,5,0,0">

                        <VerticalStackLayout>

                            <Label
                        Text="{Binding CustomerName}"
                        FontSize="20" TextColor="Black"
                        FontAttributes="Bold"/>

                            <Label
Text="{Binding PageNumber}"
FontSize="20" TextColor="Black"
FontAttributes="Bold"/>

                            <Label
Text="{Binding DeliveryDate}"
FontSize="20" TextColor="Black"
FontAttributes="Bold"/>

                            <Label
                        Text="{Binding WorkType}" TextColor="Black"/>

                            <Label TextColor="Black"
                        Text="{Binding Balance,
                        StringFormat='Balance ₹{0}'}"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>

</ContentPage>