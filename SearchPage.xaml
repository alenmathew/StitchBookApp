<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StitchBookApp.SearchPage"
             Title="SearchPage" BackgroundColor="#FFFFFF" NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Label Grid.Row="0" TextColor="LightGray" 
    Margin="30,40,0,0"
Text="Search"
FontSize="40"
FontAttributes="Bold"
VerticalOptions="StartAndExpand"
HorizontalOptions="StartAndExpand"/>

        <Label Grid.Row="1" TextColor="Black"  Margin="30,15,30,0" Text="Search Customer" FontSize="16" FontAttributes="None" />
        <Border Grid.Row="2" Margin="30,0,30,20"
    Stroke="#2F9E9E"
    StrokeThickness="1"
    StrokeShape="RoundRectangle 10"
    Padding="0"
    BackgroundColor="Transparent">

            <Entry  Margin="0,0,0,0" Background="Transparent" TextColor="#2F9E9E" BackgroundColor="LightCyan" PlaceholderColor="Gray"  FontSize="18" x:Name="SearchEntry"
Placeholder="Enter Customer Name" TextChanged="SearchEntry_TextChanged"/>

        </Border>



        <CollectionView Grid.Row="3" x:Name="SearchResults">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame BorderColor="#2F9E9E" CornerRadius="10" Margin="30,10,30,0">

                        <VerticalStackLayout>

                            <Label
                                Text="{Binding CustomerName}" TextColor="Black"  FontSize="18"/>

                            <Label TextColor="Black"  Text="{Binding WorkType}"/>
                            <Label TextColor="Black"  Text="{Binding PhoneNumber,  StringFormat='PhoneNumber: {0}'}"/>
                            <Label TextColor="Black"  Text="{Binding PageNumber,  StringFormat='PageNumber: {0}'}"/>
                            <Label TextColor="Black"  Text="{Binding CreatedDate,  StringFormat='Added Date: {0}'}"/>
                            <Label TextColor="Black"  Text="{Binding DeliveryDate,  StringFormat='DeliveryDate: {0}'}"/>
                            <Label TextColor="Black"  Text="{Binding Advance,  StringFormat='Advance Paid: {0}'}"/>
                            <Label TextColor="Black" Text="{Binding TotalAmount, StringFormat='Tota: {0}'}"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>